{
  "private": true,
  "name": "interests",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:server": "pnpm --filter @interests/server dev",
    "dev:web": "pnpm --filter @interests/web dev",
    "dev": "pnpm --parallel --filter @interests/server --filter @interests/web dev",
    "build:web": "pnpm --filter @interests/web build",
    "play": "tsx scripts/play.ts",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run --exclude '**/node_modules/**' --exclude '**/e2e/**'",
    "test:e2e": "pnpm exec playwright test",
    "test:e2e:headed": "pnpm exec playwright test --headed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@playwright/test": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
